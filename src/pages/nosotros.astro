---
import Layout from '../layouts/Layout.astro';

const pilares = [
  {
    titulo: 'Fricción cero',
    descripcion:
      'Todo el proceso —desde el diagnóstico hasta la firma de póliza— está diseñado para resolverse en llamadas cortas y mensajes directos. Nada de citas de dos horas ni formularios interminables.',
  },
  {
    titulo: 'Gestión de crisis',
    descripcion:
      'Cuando surge una hospitalización o un siniestro, no te dejamos solo frente a la aseguradora. Damos seguimiento activo al reembolso y a la reprogramación de coberturas.',
  },
  {
    titulo: 'Curaduría imparcial',
    descripcion:
      'Comparamos entre aseguradoras antes de recomendar. No estamos casados con una sola marca — estamos casados con que la cobertura te convenga a ti.',
  },
];
---

<Layout
  title="Nosotros — el concierge financiero detrás de nubenca"
  description="Conoce la metodología de nubenca: fricción cero, gestión activa de crisis y curaduría imparcial de seguros de vida y gastos médicos."
>
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
    <p class="text-sm uppercase tracking-[0.2em] text-accent">Nosotros</p>
    <h1 class="mt-4 font-heading text-4xl text-foreground sm:text-5xl">
      No somos agentes de seguros. Somos tu consultor táctico de riesgo.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      nubenca nace para profesionistas, emprendedores y médicos que necesitan una decisión de
      cobertura bien tomada, no un catálogo de pólizas. Actuamos como el filtro entre tú y un
      mercado de seguros diseñado para confundir.
    </p>
  </section>

  <section class="border-t border-gris-platino/10 bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-heading text-2xl text-foreground sm:text-3xl">Nuestra metodología</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {pilares.map((pilar) => (
          <article class="glass rounded-xl p-6">
            <h3 class="font-heading text-lg text-foreground">{pilar.titulo}</h3>
            <p class="mt-3 text-sm text-muted">{pilar.descripcion}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6">
    <h2 class="font-heading text-2xl text-foreground sm:text-3xl">
      ¿Listo para una segunda opinión sobre tu cobertura actual?
    </h2>
    <a
      href="/diagnostico"
      class="mt-6 inline-block rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition hover:opacity-90"
    >
      Agenda tu diagnóstico de 15 minutos
    </a>
  </section>
</Layout>
