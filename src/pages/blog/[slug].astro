---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const cover = post.data.imagen_portada;

// Se fuerza timeZone: "UTC" al formatear — si no, la fecha corre un día
// atrás según la zona horaria del servidor de build.
const dateFormatter = new Intl.DateTimeFormat('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const canonicalURL = new URL(post.data.seo.canonical ?? `/blog/${post.id}/`, SITE.url);
const coverURL = new URL(cover.src, SITE.url);
const publishedISO = post.data.fecha_publicacion.toISOString();
const modifiedISO = (post.data.fecha_actualizacion ?? post.data.fecha_publicacion).toISOString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.h1,
  description: post.data.seo.meta_description,
  image: [coverURL.toString()],
  datePublished: publishedISO,
  dateModified: modifiedISO,
  author: {
    '@type': 'Organization',
    name: post.data.autor,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: {
      '@type': 'ImageObject',
      // TODO: reemplazar por un logo raster (PNG/JPG, min. 112x112px) cuando
      // exista — Google no garantiza elegibilidad de rich results con SVG.
      url: new URL('/favicon.svg', SITE.url).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
};

const faqSchema = post.data.faq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.pregunta,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.respuesta,
        },
      })),
    }
  : null;

const allPosts = await getCollection('blog');
const relatedPosts = post.data.relacionados
  .map((slug) => allPosts.find((p) => p.id === slug))
  .filter((p) => p !== undefined);
---

<Layout
  title={post.data.seo.meta_title}
  description={post.data.seo.meta_description}
  canonicalPath={post.data.seo.canonical}
  noindex={post.data.seo.noindex}
  ogImage={post.data.seo.og_image ?? cover.src}
  ogType="article"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="text-sm uppercase tracking-[0.2em] text-accent">Blog</p>
    <h1 class="mt-4 font-heading text-3xl text-foreground sm:text-4xl">{post.data.h1}</h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      <span>{post.data.autor}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.fecha_publicacion.toISOString()}>
        Publicado el {dateFormatter.format(post.data.fecha_publicacion)}
      </time>
      {post.data.fecha_actualizacion && (
        <>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.fecha_actualizacion.toISOString()}>
            Actualizado el {dateFormatter.format(post.data.fecha_actualizacion)}
          </time>
        </>
      )}
    </div>

    <Image
      src={cover}
      alt={post.data.imagen_portada_alt}
      width={1200}
      height={630}
      class="mt-8 aspect-video w-full rounded-xl object-cover"
    />

    <div class="prose prose-invert prose-headings:font-heading prose-a:text-accent mt-10 max-w-none">
      <Content />
    </div>

    {post.data.faq && post.data.faq.length > 0 && (
      <div class="mt-10">
        <h2 class="font-heading text-2xl text-foreground">Preguntas frecuentes</h2>
        <div class="mt-4 space-y-4">
          {post.data.faq.map((item) => (
            <div class="border-b border-gris-platino/10 pb-4">
              <h3 class="font-heading text-base text-foreground">{item.pregunta}</h3>
              <p class="mt-2 text-sm text-muted">{item.respuesta}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    {post.data.tags.length > 0 && (
      <ul class="mt-10 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <li class="rounded-full border border-gris-platino/30 px-3 py-1 text-xs text-muted">{tag}</li>
        ))}
      </ul>
    )}

    <div class="mt-12 rounded-xl border border-gris-platino/10 bg-surface p-6 text-center">
      <p class="text-foreground">¿Quieres saber qué tan expuesto está tu patrimonio?</p>
      <div class="mt-4 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/blog/diagnostico"
          class="inline-block rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition hover:opacity-90"
        >
          Haz la auditoría de vulnerabilidad (2 min)
        </a>
        <a
          href="/diagnostico"
          class="inline-block rounded-md border border-gris-platino/30 px-5 py-2.5 text-sm font-medium text-foreground transition hover:bg-white/5"
        >
          Solicita tu cotización personalizada
        </a>
      </div>
    </div>

    {relatedPosts.length > 0 && (
      <div class="mt-12">
        <h2 class="font-heading text-xl text-foreground">Artículos relacionados</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {relatedPosts.map((related) => (
            <li>
              <a
                href={`/blog/${related.id}`}
                class="glass block rounded-lg p-4 text-sm text-foreground transition hover:border-accent"
              >
                {related.data.titulo}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Layout>
