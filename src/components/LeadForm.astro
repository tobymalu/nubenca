---
import { FORMSPREE_ENDPOINT, SITE } from '../lib/site';

interface Props {
  /** Clase extra para ajustar el contenedor desde donde se use (ej. dentro del Hero). */
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<form
  id="lead-form"
  class:list={['glass space-y-4 rounded-xl p-6 sm:p-8', className]}
  aria-label="Formulario de contacto rápido"
  action={FORMSPREE_ENDPOINT}
  method="POST"
>
  <div>
    <h2 class="font-heading text-xl text-foreground">Diagnóstico gratuito de 15 minutos</h2>
    <p class="mt-1 text-sm text-muted">Sin compromiso. Respondemos por WhatsApp el mismo día.</p>
  </div>

  <input type="hidden" name="_subject" value="Nuevo diagnóstico agendado — nubenca" />
  {/* Fallback sin JS: Formspree redirige aquí después de procesar el POST nativo. */}
  <input type="hidden" name="_next" value={`${SITE.url}/gracias`} />

  <div>
    <label for="lead-nombre" class="mb-1 block text-sm text-muted">Nombre</label>
    <input
      id="lead-nombre"
      name="nombre"
      type="text"
      required
      autocomplete="name"
      class="w-full rounded-md border border-gris-platino/30 bg-transparent px-3 py-2 text-sm text-foreground placeholder:text-muted/60 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
      placeholder="Tu nombre completo"
    />
  </div>

  <div>
    <label for="lead-telefono" class="mb-1 block text-sm text-muted">WhatsApp</label>
    <input
      id="lead-telefono"
      name="telefono"
      type="tel"
      required
      autocomplete="tel"
      class="w-full rounded-md border border-gris-platino/30 bg-transparent px-3 py-2 text-sm text-foreground placeholder:text-muted/60 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
      placeholder="10 dígitos"
    />
  </div>

  <div>
    <label for="lead-interes" class="mb-1 block text-sm text-muted">Me interesa</label>
    <select
      id="lead-interes"
      name="interes"
      class="w-full rounded-md border border-gris-platino/30 bg-azul-pizarra px-3 py-2 text-sm text-foreground focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
    >
      <option value="Gastos médicos">Gastos médicos mayores</option>
      <option value="Vida">Seguro de vida</option>
      <option value="Deducciones">Deducciones fiscales</option>
      <option value="No estoy seguro">No estoy seguro todavía</option>
    </select>
  </div>

  <button
    id="lead-form-submit"
    type="submit"
    class="w-full rounded-md bg-primary px-4 py-3 text-sm font-medium text-primary-foreground transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60"
  >
    Quiero mi diagnóstico
  </button>

  <p id="lead-form-error" class="hidden text-sm text-red-400" role="alert">
    Completa tu nombre y WhatsApp para continuar.
  </p>
  <p id="lead-form-status" class="hidden text-sm text-muted" role="status" aria-live="polite"></p>
</form>

<script>
  import { FORMSPREE_ENDPOINT } from '../lib/site';

  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('lead-form-error');
  const statusEl = document.getElementById('lead-form-status');
  const submitBtn = document.getElementById('lead-form-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const nombre = String(data.get('nombre') ?? '').trim();
    const telefono = String(data.get('telefono') ?? '').trim();
    const interes = String(data.get('interes') ?? '');

    if (!nombre || !telefono) {
      errorEl?.classList.remove('hidden');
      return;
    }
    errorEl?.classList.add('hidden');

    if (submitBtn) submitBtn.disabled = true;
    statusEl?.classList.remove('hidden');
    if (statusEl) statusEl.textContent = 'Registrando tu diagnóstico…';

    // Se registra el lead en Formspree antes de mandar a /gracias. Si
    // Formspree falla no bloqueamos el flujo — el cliente igual llega a
    // la página de confirmación y puede escribir por WhatsApp desde ahí.
    try {
      const response = await fetch(FORMSPREE_ENDPOINT, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) {
        console.error('Formspree respondió con error', response.status);
      }
    } catch (err) {
      console.error('No se pudo registrar el lead en Formspree', err);
    }

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lead_form_submit', interes });

    // Navegación real (no window.open) — un window.open después de un
    // await puede ser bloqueado por el navegador al no ser reacción
    // directa al clic. La página de gracias es la confirmación visible.
    const params = new URLSearchParams({ nombre, telefono, interes });
    window.location.href = `/gracias?${params.toString()}`;
  });
</script>
