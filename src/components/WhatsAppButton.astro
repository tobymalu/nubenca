---
import { whatsappUrl } from '../lib/site';

interface Props {
  /**
   * Pon `true` en páginas que ya traen su propio CTA fijo para mobile
   * (ej. /diagnostico) para que este botón flotante no se les encime.
   * En esos casos se sigue mostrando en desktop.
   */
  hideOnMobile?: boolean;
  message?: string;
}

const { hideOnMobile = false, message } = Astro.props;
const visibilityClass = hideOnMobile ? 'hidden sm:flex' : 'flex';
---

<a
  href={whatsappUrl(message)}
  target="_blank"
  rel="noopener noreferrer"
  class={`${visibilityClass} fixed bottom-5 right-5 z-40 items-center justify-center rounded-full bg-[#25D366] p-4 text-white shadow-lg transition hover:scale-105`}
  aria-label="Escríbenos por WhatsApp"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.06h-.01a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.11.82.83-3.04-.2-.31a8.16 8.16 0 0 1-1.26-4.34c0-4.53 3.69-8.22 8.24-8.22 2.2 0 4.27.86 5.82 2.42a8.14 8.14 0 0 1 2.41 5.81c0 4.53-3.7 8.18-8.24 8.18Zm4.52-6.15c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.78.97-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.23.25-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z" />
  </svg>
</a>
