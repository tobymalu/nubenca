---
const services = [
  {
    nombre: 'Gastos Médicos Mayores',
    descripcion:
      'Cobertura estructurada para hospitalización, cirugía y tratamientos de alto costo — revisada línea por línea, sin letra chiquita.',
    icono: 'cruz',
  },
  {
    nombre: 'Seguro de Vida',
    descripcion:
      'Protección patrimonial para tu familia o tu sociedad, diseñada según tu momento de vida y tu estructura de ingresos.',
    icono: 'escudo',
  },
  {
    nombre: 'Deducciones Fiscales',
    descripcion:
      'Tu esquema de aseguramiento revisado también desde el lado fiscal, para que sepas qué sí puedes deducir ante el SAT.',
    icono: 'documento',
  },
] as const;

const icons: Record<(typeof services)[number]['icono'], string> = {
  cruz: 'M12 4v16m8-8H4',
  escudo: 'M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z',
  documento: 'M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm7 0v5h5',
};
---

<section id="soluciones" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="max-w-2xl">
    <h2 class="font-heading text-3xl text-foreground sm:text-4xl">Portafolio de soluciones</h2>
    <p class="mt-3 text-muted">
      Tres frentes, una sola curaduría imparcial. Elegimos lo que te conviene a ti, no lo que nos
      deja más comisión.
    </p>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {services.map((service) => (
      <article class="glass flex flex-col gap-4 rounded-xl p-6">
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-primary/15 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={icons[service.icono]} />
          </svg>
        </span>
        <h3 class="font-heading text-lg text-foreground">{service.nombre}</h3>
        <p class="text-sm text-muted">{service.descripcion}</p>
        <a href="/diagnostico" class="mt-auto text-sm font-medium text-accent transition hover:opacity-80">
          Ver cómo aplica a mi caso →
        </a>
      </article>
    ))}
  </div>
</section>
